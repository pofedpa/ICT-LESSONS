void MainWindow::refreshTable()
{
    QSqlQuery query;
    int idcombox = ui->comboBox->currentData().toInt();
    QString baseSql = "SELECT "
                      "c.name AS class_name, "
                      "p.last_name || ' ' || p.first_name || ' ' || COALESCE(p.patronymic, '') AS student_name, "
                      "cl.name AS club_name "
                      "FROM students s "
                      "JOIN classes c ON s.class_id = c.id "
                      "JOIN people p ON s.person_id = p.id "
                      "LEFT JOIN club_enrollments ce ON s.id = ce.student_id "
                      "LEFT JOIN clubs cl ON ce.club_id = cl.id ";
    if(idcombox == -1){
        query.prepare(baseSql);
    }
    else {
        query.prepare(baseSql + "WHERE s.class_id = :classId");
        query.bindValue(":classId", idcombox);
    }
    if (model->lastError().isValid()) {
        qWarning() << "Ошибка запроса:" << model->lastError().text();
        return;
    }
    model->setQuery(query);

    model->setHeaderData(0, Qt::Horizontal, "Класс");
    model->setHeaderData(1, Qt::Horizontal, "Ученик");
    model->setHeaderData(2, Qt::Horizontal, "Кружок");
}

void MainWindow::loadClubs()
{
    ui->comboBoxClubs->clear();
    ui->comboBoxClubs->addItem("--- Все кружки ---", -1);

    QSqlQuery query("SELECT id, name FROM clubs ORDER BY name");

    while (query.next()) {
        int id = query.value(0).toInt();
        QString name = query.value(1).toString();
        ui->comboBoxClubs->addItem(name, id);
    }
}



#include <QTcpServer>
#include<QHostAddress>
#include<QByteArray>
#include <list>
#include <QTcpSocket>
int main()
{
    QTcpServer server;
    QStringList co =  {"1","2","3","4"};
    QObject::connect(&server,&QTcpServer::newConnection,&server,[&server,&co](){
        QTcpSocket *client = server.nextPendingConnection();
        QObject::connect(client,&QTcpSocket::readyRead,client,[client,&co](){
            QByteArray a = client->readAll();
            bool ab;
            int number = a.trimmed().toInt(&ab);
            if (ab && number >= 0 && number < co.size()) {
                client->write(co[number].toUtf8());
            }
            else qDebug()<<"извини но нет";
        });
    });
    server.listen(QHostAddress::AnyIPv4,8);
    if(!server.listen(QHostAddress::AnyIPv4,8)){
        qDebug()<<server.errorString();
    }
}

