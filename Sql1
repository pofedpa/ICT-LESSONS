MainWindow::MainWindow(QWidget *parent)
    : QMainWindow(parent)
    , ui(new Ui::MainWindow)
{
    ui->setupUi(this);

    QSqlDatabase db = QSqlDatabase::addDatabase("QSQLITE");
    db.setDatabaseName("D:/projectsall/school.sqlite3");

    if (!db.open()) {
        qWarning() << "Ошибка открытия БД:" << db.lastError().text();
        return;
    }

    model = new QSqlQueryModel(this);
    ui->table->setModel(model);
    QObject::connect(ui->comboBox, QOverload<int>::of(&QComboBox::currentIndexChanged),this, &MainWindow::refreshTable);
    loadComboBox();
    refreshTable();
