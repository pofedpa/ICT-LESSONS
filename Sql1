MainWindow::~MainWindow()
{
    delete ui;
}


void MainWindow::loadComboBox()
{
    ui->comboBox->clear();
    ui->comboBox->addItem("", -1);
    QSqlQuery query("SELECT id,name FROM classes");

    if (query.lastError().isValid()) {
        qWarning() << "Ошибка ComboBox:" << query.lastError().text();
        return;
    }

    while (query.next()) {
        int id = query.value(0).toInt();
        QString name = query.value(1).toString();
        ui->comboBox->addItem(name, id);
    }
}

void MainWindow::refreshTable()
{
    int idcombox = ui->comboBox->currentData().toInt();
    QString a;
    if(idcombox == -1){
        model->setQuery("SELECT name, grade_level, direction_id, homeroom_teacher_id FROM classes");
    }
    else {
        model->setQuery(QString("SELECT name, grade_level, direction_id, homeroom_teacher_id FROM classes WHERE id = %1").arg(idcombox));
    }
    if (model->lastError().isValid()) {
        qWarning() << "Ошибка запроса:" << model->lastError().text();
