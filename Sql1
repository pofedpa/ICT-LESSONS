('С’, ’ Е', 650.00),
('А’,’П', 340.00);

UPDATE book
SET price = price - 20;

SELECT title FROM book
ORDER BY price ASC
LIMIT 0,2;

SELECT AVG(price) FROM book;

SELECT * FROM book;

